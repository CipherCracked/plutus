# Plutus — Environment Variables
#
# This file is a TEMPLATE. Copy it to .env and fill in your values.
# The .env file is gitignored and will never be committed.
#
# NOTE: You do NOT need your Supabase anon key.
# The seed script and backend connect via PostgreSQL protocol
# (DATABASE_URL only), not via Supabase REST API.
#

# Required: Supabase PostgreSQL connection string
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
# Format: postgresql://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Optional: browser origins allowed to call this API (CORS), comma-separated.
# Unset, the API is open to all origins — fine for this public demo, which
# uses no credentials. Set it to lock the API to specific frontends:
#   ALLOWED_ORIGINS=https://your-frontend.vercel.app
ALLOWED_ORIGINS=
