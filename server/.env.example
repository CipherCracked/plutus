# Plutus — Database Configuration
# Copy to .env and fill in your Supabase connection string

# Get this from your Supabase project settings → Database → Connection string
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Example (Supabase):
# DATABASE_URL=postgresql://postgres:your-password@db.abcdefghijklmnop.supabase.co:5432/postgres
